# /etc/leaf-camera-relay.env — CHMOD 600, never commit
# Generate with: openssl rand -hex 32  (must match Laravel LEAF_CAMERA_RELAY_JWT_SECRET)
RELAY_JWT_SECRET=REPLACE_WITH_64_HEX_CHARS
# Comma-separated list of valid camera device tokens (from leaf:provision-camera)
RELAY_DEVICE_TOKENS=leaf_placeholder_replace_me
RELAY_LISTEN=127.0.0.1:8300
RELAY_LOG_LEVEL=info
