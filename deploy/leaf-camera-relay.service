# Project L.E.A.F. Camera Relay — systemd unit
#
# Install:
#   sudo cp deploy/leaf-camera-relay.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now leaf-camera-relay
#
# Secrets come from the environment, NOT this file:
#   RELAY_JWT_SECRET    — must equal Laravel's LEAF_CAMERA_RELAY_JWT_SECRET
#   RELAY_DEVICE_TOKENS — comma-separated valid camera device tokens

[Unit]
Description=Project L.E.A.F. Camera Relay Service
After=network.target nginx.service
Wants=network.target

[Service]
Type=simple
# Update path to where you place the compiled binary
ExecStart=/usr/local/bin/leaf-camera-relay
Restart=always
RestartSec=5
User=leaf
Group=leaf
# Place real values in /etc/leaf-camera-relay.env (chmod 600) and use:
# EnvironmentFile=/etc/leaf-camera-relay.env
Environment=RELAY_LISTEN=127.0.0.1:8300
Environment=RELAY_LOG_LEVEL=info
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
